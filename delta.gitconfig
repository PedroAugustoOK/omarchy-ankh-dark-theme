# Ankh Dark companion configuration for git-delta.
# Include it from ~/.gitconfig instead of replacing existing Git settings:
#   [include]
#     path = /absolute/path/to/delta.gitconfig

[delta]
    features = ankh-dark

[delta "ankh-dark"]
    syntax-theme = ansi
    plus-style = syntax "#8CAF9A"
    minus-style = syntax "#D4878F"
    zero-style = syntax "#8A9AAA"
    file-style = "#84A9C7" bold
    hunk-header-style = "#86B4BF" italic
    line-numbers = true
    line-numbers-minus-style = "#D4878F"
    line-numbers-plus-style = "#8CAF9A"
