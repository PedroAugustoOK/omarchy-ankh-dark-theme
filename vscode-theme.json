{
  "$schema": "vscode://schemas/color-theme",
  "name": "Omarchy Ankh Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#86B4BF",
    "property": "#86B4BF",
    "variable": "#E8EEF2",
    "function": "#9BBFDC",
    "method": "#9BBFDC",
    "class": "#E0BD77",
    "interface": "#E0BD77",
    "enum": "#E0BD77",
    "type": "#E0BD77",
    "typeParameter": "#E0BD77",
    "string": "#A2C2AE",
    "number": "#D79A7D",
    "boolean": "#E0BD77",
    "enumMember": "#E0BD77",
    "variable.readonly": "#E0BD77",
    "operator": "#9ACBD3",
    "keyword": "#D2AD68",
    "macro": "#9ACBD3",
    "decorator": "#9BBFDC",
    "comment": {
      "foreground": "#8A9AAA",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A9AAA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#A2C2AE"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D79A7D"
      }
    },
    {
      "scope": [
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E0BD77"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D2AD68"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#9BBFDC"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#E0BD77"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#9ACBD3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E8EEF2"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#86B4BF"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9BBFDC"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8A9AAA"
      }
    }
  ],
  "colors": {
    "editor.foreground": "#E8EEF2",
    "editor.background": "#101923",
    "editorLineNumber.foreground": "#8A9AAA",
    "editorLineNumber.activeForeground": "#84A9C7",
    "editorCursor.foreground": "#84A9C7",
    "editor.lineHighlightBackground": "#18253580",
    "editor.selectionBackground": "#263D53",
    "activityBar.background": "#182535",
    "activityBar.foreground": "#E8EEF2",
    "activityBar.activeBorder": "#84A9C7",
    "sideBar.background": "#182535",
    "sideBar.foreground": "#E8EEF2",
    "sideBar.border": "#0B121B",
    "tab.activeBackground": "#101923",
    "tab.inactiveBackground": "#182535",
    "statusBar.background": "#84A9C7",
    "statusBar.foreground": "#101923",
    "titleBar.activeBackground": "#101923",
    "titleBar.activeForeground": "#E8EEF2",
    "editorError.foreground": "#E09AA1",
    "editorWarning.foreground": "#E0BD77",
    "editorInfo.foreground": "#9BBFDC",
    "focusBorder": "#84A9C7",
    "foreground": "#E8EEF2",
    "descriptionForeground": "#8A9AAA",
    "disabledForeground": "#8A9AAA",
    "errorForeground": "#E09AA1",
    "editor.selectionForeground": "#E8EEF2",
    "editor.inactiveSelectionBackground": "#263D53",
    "list.activeSelectionBackground": "#263D53",
    "list.activeSelectionForeground": "#E8EEF2",
    "list.inactiveSelectionBackground": "#263D53",
    "list.inactiveSelectionForeground": "#E8EEF2",
    "list.focusBackground": "#263D53",
    "list.focusForeground": "#E8EEF2",
    "list.hoverBackground": "#182535",
    "list.hoverForeground": "#E8EEF2",
    "list.highlightForeground": "#84A9C7",
    "activityBar.inactiveForeground": "#8A9AAA",
    "editorGroupHeader.tabsBackground": "#182535",
    "tab.activeForeground": "#E8EEF2",
    "tab.inactiveForeground": "#8A9AAA",
    "tab.activeBorderTop": "#84A9C7",
    "tab.border": "#182535",
    "titleBar.inactiveBackground": "#182535",
    "titleBar.inactiveForeground": "#8A9AAA",
    "panel.background": "#101923",
    "panel.border": "#0B121B",
    "panelTitle.activeForeground": "#E8EEF2",
    "panelTitle.inactiveForeground": "#8A9AAA",
    "panelTitle.activeBorder": "#84A9C7",
    "input.background": "#101923",
    "input.foreground": "#E8EEF2",
    "input.border": "#8A9AAA",
    "input.placeholderForeground": "#8A9AAA",
    "dropdown.background": "#182535",
    "dropdown.foreground": "#E8EEF2",
    "dropdown.border": "#8A9AAA",
    "button.background": "#84A9C7",
    "button.foreground": "#101923",
    "badge.background": "#84A9C7",
    "badge.foreground": "#101923",
    "statusBar.noFolderBackground": "#84A9C7",
    "statusBar.noFolderForeground": "#101923",
    "statusBar.debuggingBackground": "#84A9C7",
    "statusBar.debuggingForeground": "#101923",
    "editorWidget.background": "#182535",
    "editorWidget.foreground": "#E8EEF2",
    "editorWidget.border": "#8A9AAA",
    "editorSuggestWidget.background": "#182535",
    "editorSuggestWidget.foreground": "#E8EEF2",
    "editorSuggestWidget.selectedBackground": "#263D53",
    "editorSuggestWidget.selectedForeground": "#E8EEF2",
    "editorSuggestWidget.highlightForeground": "#84A9C7",
    "menu.background": "#182535",
    "menu.foreground": "#E8EEF2",
    "menu.selectionBackground": "#263D53",
    "menu.selectionForeground": "#E8EEF2",
    "notifications.background": "#182535",
    "notifications.foreground": "#E8EEF2",
    "terminal.background": "#101923",
    "terminal.foreground": "#E8EEF2",
    "editorBracketHighlight.foreground1": "#9BBFDC",
    "editorBracketHighlight.foreground2": "#E0BD77",
    "editorBracketHighlight.foreground3": "#86B4BF",
    "editorBracketHighlight.foreground4": "#D2AD68",
    "editorBracketHighlight.foreground5": "#A2C2AE",
    "editorBracketHighlight.foreground6": "#D79A7D",
    "terminal.ansiBlack": "#101923",
    "terminal.ansiRed": "#D4878F",
    "terminal.ansiGreen": "#8CAF9A",
    "terminal.ansiYellow": "#D2AD68",
    "terminal.ansiBlue": "#84A9C7",
    "terminal.ansiMagenta": "#B09ABF",
    "terminal.ansiCyan": "#86B4BF",
    "terminal.ansiWhite": "#B7C8D4",
    "terminal.ansiBrightBlack": "#8A9AAA",
    "terminal.ansiBrightRed": "#E09AA1",
    "terminal.ansiBrightGreen": "#A2C2AE",
    "terminal.ansiBrightYellow": "#E0BD77",
    "terminal.ansiBrightBlue": "#9BBFDC",
    "terminal.ansiBrightMagenta": "#C2ACD0",
    "terminal.ansiBrightCyan": "#9ACBD3",
    "terminal.ansiBrightWhite": "#F7FAFC",
    "editorHint.foreground": "#9ACBD3"
  }
}
