{
  "$schema": "vscode://schemas/color-theme",
  "name": "Omarchy Ankh Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "parameter": "#86B4BF",
    "property": "#86B4BF",
    "variable": "#E8EEF2",
    "function": "#9BBFDC",
    "method": "#9BBFDC",
    "class": "#E0BD77",
    "interface": "#E0BD77",
    "enum": "#E0BD77",
    "type": "#E0BD77",
    "typeParameter": "#E0BD77",
    "string": "#A2C2AE",
    "number": "#D79A7D",
    "boolean": "#D79A7D",
    "operator": "#9ACBD3",
    "keyword": "#D2AD68",
    "macro": "#9ACBD3",
    "decorator": "#9BBFDC",
    "comment": {
      "foreground": "#8A9AAA",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A9AAA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#A2C2AE"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#D79A7D"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D2AD68"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#9BBFDC"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#E0BD77"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#9ACBD3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#E8EEF2"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#9BBFDC"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8A9AAA"
      }
    }
  ],
  "colors": {
    "editor.foreground": "#E8EEF2",
    "editor.background": "#101923",
    "editorLineNumber.foreground": "#8A9AAA",
    "editorLineNumber.activeForeground": "#84A9C7",
    "editorCursor.foreground": "#84A9C7",
    "editor.lineHighlightBackground": "#18253580",
    "editor.selectionBackground": "#263D5380",
    "activityBar.background": "#182535",
    "activityBar.foreground": "#E8EEF2",
    "activityBar.activeBorder": "#84A9C7",
    "sideBar.background": "#182535",
    "sideBar.foreground": "#E8EEF2",
    "sideBar.border": "#0B121B",
    "tab.activeBackground": "#101923",
    "tab.inactiveBackground": "#182535",
    "statusBar.background": "#84A9C7",
    "statusBar.foreground": "#101923",
    "titleBar.activeBackground": "#101923",
    "titleBar.activeForeground": "#E8EEF2",
    "editorError.foreground": "#E09AA1",
    "editorWarning.foreground": "#E0BD77",
    "editorInfo.foreground": "#9BBFDC",
    "focusBorder": "#84A9C7"
  }
}
